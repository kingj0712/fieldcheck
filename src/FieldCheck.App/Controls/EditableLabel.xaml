<UserControl x:Class="FieldCheck.App.Controls.EditableLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FieldCheck.App.Controls"
             Focusable="False">
    <Grid>
        <!-- Display mode: text + a subtle pencil that appears on hover or focus. -->
        <Grid x:Name="DisplayRoot" Background="Transparent" MouseLeftButtonDown="DisplayRoot_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DisplayText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding Text, RelativeSource={RelativeSource AncestorType={x:Type local:EditableLabel}}}"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource AncestorType={x:Type local:EditableLabel}}}" />
            <Button x:Name="EditButton" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets" Content="&#xE70F;"
                    FontSize="12" ToolTip="Rename" Click="EditButton_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Edit mode -->
        <TextBox x:Name="EditBox" Visibility="Collapsed"
                 KeyDown="EditBox_KeyDown" LostKeyboardFocus="EditBox_LostKeyboardFocus" />
    </Grid>
</UserControl>
