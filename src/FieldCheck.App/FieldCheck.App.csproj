<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FieldCheck.App</RootNamespace>
    <AssemblyName>FieldCheck</AssemblyName>
    <ApplicationIcon>Assets\fieldcheck.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>FieldCheck</Product>
    <Company>FieldCheck</Company>
    <Description>FieldCheck - a lightweight local commissioning and field checklist tool.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Self-contained / single-file / RID are supplied by build\publish-win-x64.ps1 so that
         everyday dev builds and `dotnet test` stay fast and framework-dependent. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldCheck.Core\FieldCheck.Core.csproj" />
  </ItemGroup>

</Project>
