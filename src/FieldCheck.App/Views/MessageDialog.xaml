<Window x:Class="FieldCheck.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FieldCheck"
        SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Border Padding="24">
        <StackPanel>
            <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap" />
            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.Secondary}" LineHeight="19" />
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" Margin="0,0,10,0"
                        IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Content="OK" MinWidth="90"
                        Style="{StaticResource AccentButton}" IsDefault="True" Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
